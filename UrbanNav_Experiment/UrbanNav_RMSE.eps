[0.48 0 0 0.48015 0 134.92319] CT
[1 0 0 1 0 0] CT
N
0 -281 M
1250 -281 L
1250 500 L
0 500 L
0 -281 L
cp
clip
GS
0 0 translate
800 500 scale
