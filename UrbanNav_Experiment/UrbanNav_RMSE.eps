%AXGEndBitmap
GR
GR
GS
[0.48 0 0 0.48015 384.00004 134.92319] CT
[1 0 0 1 0 0] CT
N
-800 -281 M
450 -281 L
450 500 L
-800 500 L
-800 -281 L
cp
clip
GS
0 0 translate
450 500 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 500
  /ImageMatrix [450 0 0 500 0 0]
  /Width 450
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
