%%PageBoundingBox: 0 0 600 375
%%BeginPageSetup
N
    0     0 M
  601     0 L
  601   376 L
    0   376 L
cp
clip
[1 0 0 -1 0 375] CT
%%EndPageSetup
GS
[0.75 0 0 0.75 0 0] CT
1 GC
N
0 0 800 500 re
f
GR
GS
[0.48 0 0 0.48015 0 134.92319] CT
[1 0 0 1 0 0] CT
N
0 -281 M
1250 -281 L
1250 500 L
0 500 L
0 -281 L
cp
clip
GS
0 0 translate
800 500 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
